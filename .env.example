# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon URLs (…neon.tech…) use the Neon serverless driver automatically.
DATABASE_URL=postgres://localhost:5432/weretro
# Public URL of this app (used in emails and OAuth callbacks)
APP_URL=http://localhost:3000
# Random string used to sign guest links. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Force a database driver: "neon" or "pg"
# DB_DRIVER=

# Email (any SMTP server). Without it, emails are printed to the server log and visible at /dev/mail in development.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="WeRetro <no-reply@example.com>"

# AI features (Claude). Leave empty to disable AI.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Sign in with Google / GitHub / Microsoft
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# GIF search in ideas and comments
# GIPHY_API_KEY=
# TENOR_API_KEY=

# Protects /api/cron (scheduled standups, reminders). Vercel Cron sends it as a Bearer token.
# CRON_SECRET=

# Link shown on the landing page
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/weretro
